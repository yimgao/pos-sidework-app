# 复制成 .env 再填真值。不要把 .env 提交到 GitHub。
DATABASE_URL=postgresql://possidework:pos-sidework-dev-only@localhost:5432/pos_sidework
# OAuth（经理登录用，选一个平台先填）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/callback
# Stripe（Billing 模块，关闭状态时留空）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Twilio（Notifications 短信模块，关闭状态时留空）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMTP（每日报告邮件）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MANAGER_EMAIL=
# AI（照片预筛 + 以后 AI 总结；不填 = 只做文件检查，不花钱）
# 推荐低成本：AI_PROVIDER=gemini, AI_VISION_MODEL=gemini-2.5-flash-lite
# 或 AI_PROVIDER=openai, AI_VISION_MODEL=gpt-5-mini
AI_PROVIDER=gemini
AI_VISION_MODEL=gemini-2.5-flash-lite
AI_API_KEY=
AI_BASE_URL=
